{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mc7dtd.invalid/schemas/entity_components_v1.schema.json",
  "title": "MC7DTD Entity Components v1 with optional identity display_name",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "version",
    "entity_state_version",
    "source",
    "authority",
    "origin",
    "entity_id",
    "world_id",
    "dimension",
    "entity_type",
    "stream_id",
    "entity_sequence",
    "revision",
    "base_revision",
    "mode",
    "components"
  ],
  "properties": {
    "type": {
      "const": "entity_components"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "entity_state_version": {
      "type": "integer",
      "const": 2
    },
    "source": {
      "enum": [
        "minecraft",
        "7dtd"
      ]
    },
    "authority": {
      "enum": [
        "minecraft",
        "7dtd"
      ]
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "game",
        "world_id",
        "dimension",
        "entity_id"
      ],
      "properties": {
        "game": {
          "enum": [
            "minecraft",
            "7dtd"
          ]
        },
        "world_id": {
          "$ref": "entity_state_v2.schema.json#/$defs/world"
        },
        "dimension": {
          "$ref": "entity_state_v2.schema.json#/$defs/name"
        },
        "entity_id": {
          "$ref": "entity_state_v2.schema.json#/$defs/uuid"
        }
      }
    },
    "entity_id": {
      "$ref": "entity_state_v2.schema.json#/$defs/uuid"
    },
    "world_id": {
      "$ref": "entity_state_v2.schema.json#/$defs/world"
    },
    "dimension": {
      "$ref": "entity_state_v2.schema.json#/$defs/name"
    },
    "entity_type": {
      "$ref": "entity_state_v2.schema.json#/$defs/name"
    },
    "stream_id": {
      "$ref": "entity_state_v2.schema.json#/$defs/uuid"
    },
    "entity_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "base_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "mode": {
      "enum": [
        "snapshot",
        "patch"
      ]
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 5,
      "properties": {
        "health": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "current",
                "max"
              ],
              "properties": {
                "current": {
                  "type": "number",
                  "minimum": 0
                },
                "max": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "display_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "animation_state": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state"
              ],
              "properties": {
                "state": {
                  "$ref": "entity_state_v2.schema.json#/$defs/name"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "custom_metadata": {
          "oneOf": [
            {
              "type": "object",
              "maxProperties": 32,
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$",
                "not": {
                  "pattern": "\\s"
                }
              },
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ],
                "maxLength": 256
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "equipment": {
          "oneOf": [
            {
              "$ref": "equipment_component_v1.schema.json#/$defs/patch"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "snapshot"
          }
        }
      },
      "then": {
        "properties": {
          "base_revision": {
            "const": 0
          },
          "components": {
            "properties": {
              "health": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "current",
                  "max"
                ],
                "properties": {
                  "current": {
                    "type": "number",
                    "minimum": 0
                  },
                  "max": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              "name": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "display_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                }
              },
              "animation_state": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "$ref": "entity_state_v2.schema.json#/$defs/name"
                  }
                }
              },
              "custom_metadata": {
                "type": "object",
                "maxProperties": 32,
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$",
                  "not": {
                    "pattern": "\\s"
                  }
                },
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ],
                  "maxLength": 256
                }
              },
              "equipment": {
                "$ref": "equipment_component_v1.schema.json#/$defs/snapshot"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "base_revision": {
            "minimum": 1
          },
          "components": {
            "minProperties": 1
          }
        }
      }
    }
  ]
}
