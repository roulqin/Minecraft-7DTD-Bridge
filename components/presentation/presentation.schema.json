{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entity Presentation System v1 field patch",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "renderer": {
      "type": "string",
      "pattern": "^[a-z0-9_.:-]{1,64}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "model": {
      "type": "string",
      "pattern": "^[a-z0-9_.:-]{1,64}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "variant": {
      "type": "string",
      "pattern": "^[a-z0-9_.:-]{1,64}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "scale": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 16
    }
  }
}
